<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aichat.chat.mapper.ChatMessageKnowledgeBaseMapper">
    <select id="selectKnowledgeBaseIds" resultType="long">
        select knowledge_base_id
        from chat_message_knowledge_base
        where message_id = #{messageId}
        order by id
    </select>
</mapper>
