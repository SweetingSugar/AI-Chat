<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aichat.chat.mapper.ChatMessageKnowledgeSourceMapper">
    <select id="selectByMessageIds" resultType="com.example.aichat.chat.entity.ChatMessageKnowledgeSource">
        select id, message_id, knowledge_base_id, document_id, chunk_id, title, content,
               score, rank_no, create_time
        from chat_message_knowledge_source
        where message_id in
        <foreach collection="messageIds" item="messageId" open="(" separator="," close=")">
            #{messageId}
        </foreach>
        order by message_id, rank_no, id
    </select>
</mapper>
