<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aichat.system.mapper.UserMapper">

    <select id="findByUsername" resultType="com.example.aichat.system.entity.SysUser">
        select *
        from sys_user
        where username = #{username}
          and deleted = 0
        limit 1
    </select>
</mapper>
